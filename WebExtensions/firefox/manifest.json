{
    "manifest_version": 3,
    "name": "UPasswords",
    "version": "1.1",
    "description": "UPasswords password manager companion for Firefox.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "permissions"
    ],
    "host_permissions": [
        "https://api.upasswords.com/*"
    ],
    "background": {
        "scripts": [
            "src/background.js"
        ],
        "type": "module"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "upasswords@upasswords.com",
            "strict_min_version": "121.0"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_title": "UPasswords",
        "default_popup": "src/popup.html"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
}
