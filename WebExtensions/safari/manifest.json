{
    "manifest_version": 3,
    "name": "UPasswords for Safari",
    "version": "1.2",
    "description": "UPasswords password manager companion for Safari.",
    "permissions": [
        "activeTab",
        "storage",
        "alarms",
        "tabs",
        "clipboardWrite"
    ],
    "host_permissions": [
        "https://api.upasswords.com/*"
    ],
    "background": {
        "scripts": [
            "src/background.js"
        ],
        "persistent": false
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_title": "UPasswords",
        "default_popup": "src/popup.html"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; connect-src 'self' https://api.upasswords.com; default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
}
