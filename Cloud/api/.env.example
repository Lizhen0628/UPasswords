# Copy to .env (chmod 600); use literal values, no shell export or surrounding quotes.
HTTP_ADDR=:8080
DB_ADDRESS=10.0.3.198:6033
DB_NAME=upasswords
DB_USER=
DB_PASSWORD=
# Pinned mode verifies the server public key against this PEM certificate bundle.
DB_TLS=pinned
DB_CA_FILE=/run/secrets/mariadb.pem
# MUST reuse the existing production value when reading an existing database.
APP_KEK=
ADMIN_TOKEN=
R2_ENDPOINT=
R2_BUCKET=upasswords
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_FROM=
SMTP_REPLY_TO=register@upasswords.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_REGISTER_REPLY_TO=register@upasswords.com
SMTP_VERIFY_REPLY_TO=verify@upasswords.com
# Exact existing nginxui container address, not a trusted subnet.
TRUSTED_PROXY_IP=172.104.1.2
