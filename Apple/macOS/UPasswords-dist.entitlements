<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- dist 本地分发形态的最小 entitlements:只声明应用组,
	     让 ~/Library/Group Containers/group.com.upasswords.shared 成为
	     "本组数据"(SafariSnapshotBridge 推送加密快照),不再触发
	     macOS TCC「访问其他 App 的数据」授权弹窗。
	     刻意不带 app-sandbox:dist 形态沿用直读数据目录的既有行为,
	     完整沙盒 entitlements 见 UPasswords.entitlements(Xcode 形态)。 -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.upasswords.shared</string>
	</array>
</dict>
</plist>
