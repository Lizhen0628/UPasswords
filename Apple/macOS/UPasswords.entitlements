<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Safari Web Extension 硬性要求:宿主 App 必须沙盒化,扩展才会注册。 -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- WebDAV 同步 / HIBP 泄露检查 / 站点图标抓取 -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- 导入/导出文件、选择 iCloud 云盘文件夹 -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- 持久化 iCloud 文件夹安全作用域书签 -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- 与 Safari 扩展共享:加密库快照推送目标 -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.upasswords.shared</string>
	</array>
	<!-- 沙盒化一次性迁移:读未沙盒时代的库目录与偏好 plist,
	     数据拷入容器后这两个例外即不再被触碰(本地分发形态,不上 App Store)。 -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/Application Support/UPasswords/</string>
	</array>
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Preferences/com.upasswords.UPasswords.plist</string>
	</array>
</dict>
</plist>
